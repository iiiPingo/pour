<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Pour</AssemblyName>
    <RootNamespace>Pour</RootNamespace>
    <ApplicationIcon>pour.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.4.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Pour</Product>
    <Description>Pour - video and audio downloader</Description>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <!-- Linux/Mono builds: use Mono's .NET Framework 4.8 reference assemblies. On Windows the normal
       reference-assembly package is used, so a plain `dotnet build -c Release` works. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' And Exists('/usr/lib/mono/4.8-api')">
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <FrameworkPathOverride>/usr/lib/mono/4.8-api</FrameworkPathOverride>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
  </PropertyGroup>
  <ItemGroup>

    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <!-- Lexend, the same files Minibar uses (SIL Open Font License 1.1, see src/fonts/OFL.txt) -->
    <EmbeddedResource Include="fonts\Lexend-Medium.ttf" LogicalName="fonts.Lexend-Medium.ttf" />
    <EmbeddedResource Include="fonts\Lexend-Bold.ttf" LogicalName="fonts.Lexend-Bold.ttf" />
  </ItemGroup>
</Project>
